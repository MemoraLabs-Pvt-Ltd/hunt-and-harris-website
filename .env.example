# Google Apps Script web-app URL that receives website form submissions
# (Contact + Off-Plan Register Interest) and appends them to the Google Sheet.
# Get this by deploying google-apps-script/Code.gs as a Web app.
# Copy this file to .env.local for local dev, and set the same var in Vercel.
SHEETS_ENDPOINT=https://script.google.com/macros/s/XXXXXXXX/exec
